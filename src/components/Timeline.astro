---
export type TimelineItem = {
	period: string;
	title: string;
	company?: string;
	description: string;
	tags?: string[];
};

type Props = {
	items: TimelineItem[];
	highlightLatest?: boolean;
};

const { items, highlightLatest = false } = Astro.props;
---

<ol class="timeline">
	{items.map((item, index) => (
		<li class:list={["timeline__item", { "timeline__item--latest": highlightLatest && index === 0 }]}>
			<p class="timeline__period">{item.period}</p>
			<h3 class="timeline__title">
				{item.title}
				{item.company && <span class="timeline__company"> · {item.company}</span>}
			</h3>
			<p class="timeline__description">{item.description}</p>
			{item.tags && item.tags.length > 0 && (
				<ul class="timeline__tags">
					{item.tags.map((tag) => (
						<li class="timeline__tag">{tag}</li>
					))}
				</ul>
			)}
		</li>
	))}
</ol>

<style>
	.timeline {
		--timeline-muted: #888888;
		--timeline-line: #3a3a3a;
		--timeline-gap: 2rem;

		display: flex;
		flex-direction: column;
		gap: var(--timeline-gap);
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.timeline__item {
		position: relative;
		padding-left: 1.75rem;
	}

	/* Continuous vertical line. */
	.timeline__item::before {
		content: "";
		position: absolute;
		top: 0.375rem;
		bottom: calc(-1 * var(--timeline-gap));
		left: 0.3125rem;
		width: 2px;
		background-color: var(--timeline-line);
	}

	.timeline__item:last-child::before {
		bottom: 0;
	}

	/* Dot marker aligned with the period line. */
	.timeline__item::after {
		content: "";
		position: absolute;
		top: 0.375rem;
		left: 0;
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		background-color: var(--text);
	}

	.timeline__item--latest::after {
		--timeline-beacon: #b8d9c0;
		background-color: var(--timeline-beacon);
	}

	@keyframes timeline-beacon {
		0% {
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--timeline-beacon) 45%, transparent);
		}
		70%,
		100% {
			box-shadow: 0 0 0 8px transparent;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.timeline__item--latest::after {
			animation: timeline-beacon 2.5s ease-out infinite;
		}
	}

	.timeline__period {
		margin: 0;
		font-size: 13px;
		line-height: 1.4;
		color: var(--timeline-muted);
	}

	.timeline__title {
		margin: 0.25rem 0 0;
		font-size: 17px;
		font-weight: 500;
		line-height: 1.4;
	}

	.timeline__company {
		font-weight: 400;
		color: var(--timeline-muted);
	}

	.timeline__description {
		margin: 0.5rem 0 0;
	}

	.timeline__tags {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
	}

	/* Override the global "▪" bullet on li. */
	.timeline__tag {
		padding: 0.125rem 0.625rem;
		border: 1px solid var(--timeline-line);
		border-radius: 999px;
		font-size: 13px;
		color: var(--timeline-muted);
	}

	.timeline__tag::before {
		content: none;
	}
</style>

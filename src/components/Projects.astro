---
export type Project = {
	name: string;
	description: string;
	link?: string;
	tags?: string[];
};

type Props = {
	items: Project[];
};

const { items } = Astro.props;
---

<ul class="projects">
	{items.map((project) => (
		<li class="projects__item">
			<h3 class="projects__name">
				{project.link ? (
					<a class="projects__link" href={project.link} target="_blank" rel="noopener noreferrer">
						{project.name}
						<svg
							class="projects__link-icon"
							xmlns="http://www.w3.org/2000/svg"
							width="14"
							height="14"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M7 17L17 7" />
							<path d="M7 7h10v10" />
						</svg>
					</a>
				) : (
					project.name
				)}
			</h3>
			<p class="projects__description">{project.description}</p>
			{project.tags && project.tags.length > 0 && (
				<ul class="projects__tags">
					{project.tags.map((tag) => (
						<li class="projects__tag">{tag}</li>
					))}
				</ul>
			)}
		</li>
	))}
</ul>

<style>
	.projects {
		--projects-muted: #888888;
		--projects-line: #3a3a3a;

		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	/* Card look distinguishes projects from the experience timeline. */
	.projects__item {
		padding: 1rem 1.125rem;
		border: 1px solid var(--projects-line);
		border-radius: 0.5rem;
		transition: border-color 0.2s ease;
	}

	.projects__item:hover {
		border-color: var(--projects-muted);
	}

	/* Override the global "▪" bullet on li. */
	.projects__item::before {
		content: none;
	}

	.projects__name {
		margin: 0;
		font-size: 17px;
		font-weight: 500;
		line-height: 1.4;
	}

	.projects__link {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		text-decoration: none;
	}

	.projects__link:hover {
		color: var(--link-hover);
		opacity: 1;
	}

	.projects__link-icon {
		flex-shrink: 0;
		color: var(--projects-muted);
	}

	.projects__link:hover .projects__link-icon {
		color: inherit;
	}

	.projects__description {
		margin: 0.5rem 0 0;
	}

	.projects__tags {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
	}

	.projects__tag {
		padding: 0.125rem 0.625rem;
		border: 1px solid var(--projects-line);
		border-radius: 999px;
		font-size: 13px;
		color: var(--projects-muted);
	}

	.projects__tag::before {
		content: none;
	}
</style>
